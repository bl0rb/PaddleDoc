# paddledoc runtime tuning (docker compose)
# Copy to .env and adjust for your host.

# --- Authentication (required since v1.1.0) ---------------------------------

# Signs session cookies and the OIDC state cookie, and derives the key used
# to encrypt OIDC client secrets stored via the admin UI. Generate once
# (e.g. `openssl rand -hex 32`) and NEVER change it afterwards: rotation
# invalidates every session and makes stored OIDC client secrets unreadable.
SECRET_KEY=generate-me-with-openssl-rand-hex-32

# --- The two API URLs, which are NOT the same thing -------------------------
# PUBLIC_API_URL       is read by the BACKEND, server-side, to build OIDC
#                      redirect URIs. It must be the URL your OIDC provider
#                      can reach.
# PADDLEDOC_PUBLIC_API_URL is read by the FRONTEND and handed to the BROWSER.
#                      It must be the URL the browser can reach, and it also
#                      goes into the frontend's CSP connect-src.
# They only coincide when the browser and the OIDC provider see the backend
# under the same name.

# Backend URL used to build OIDC redirect URIs
# ({PUBLIC_API_URL}/api/v1/auth/oidc/{slug}/callback).
PUBLIC_API_URL=http://localhost:8000

# Backend URL the browser calls. Optional: left unset, the frontend derives
# `<page protocol>//<page hostname>:8000`, which is right whenever backend and
# frontend share a host. Set it when they do not -- e.g. a reverse proxy that
# serves the API under a different name.
# Whatever you set here must have the SAME HOST as the page in the address
# bar. Mixing localhost and an IP makes the browser treat the session cookie
# as cross-site, and SameSite=lax then drops it: login returns 200 and every
# following request is 401.
# PADDLEDOC_PUBLIC_API_URL=http://localhost:8000

# Allowed frontend origin(s) as a JSON array. Must be concrete origins, not
# "*": responses are credentialed (session cookie). List every origin you open
# the UI under. Example for a NAS:
# CORS_ORIGINS=["http://192.168.1.50:3000"]
CORS_ORIGINS=["http://localhost:3000"]

# Redis requirepass. Redis is the Celery broker/result backend, reachable
# from every backend/worker container -- set a real password here for
# anything beyond local dev. Must match between the `redis` service command
# and the backend/worker REDIS_URL (docker-compose.yml already references
# this same variable in both places).
REDIS_PASSWORD=paddledoc-dev-redis-password

# Worker container resource limits
WORKER_MEMORY_LIMIT=3g
WORKER_CPUS=2.0

# Celery worker tuning
CELERY_WORKER_CONCURRENCY=1
CELERY_PREFETCH_MULTIPLIER=1
CELERY_MAX_TASKS_PER_CHILD=20
CELERY_LOG_LEVEL=info

# Celery task hard/soft time limits (seconds) + matching broker
# visibility_timeout. visibility_timeout must stay >= the hard limit or a
# still-running long OCR task can be redelivered/duplicated.
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1500
CELERY_TASK_TIME_LIMIT_SECONDS=1800
CELERY_BROKER_VISIBILITY_TIMEOUT_SECONDS=1800

# ONNX / OpenMP memory+CPU tuning (especially helpful on small ARM hosts)
OMP_NUM_THREADS=1
ONNXRUNTIME_INTRA_OP_NUM_THREADS=1
ONNXRUNTIME_INTER_OP_NUM_THREADS=1
MALLOC_ARENA_MAX=2

# Hostnames ("host" or "host:port") of self-hosted VL endpoints (vLLM, Ollama,
# LiteLLM) on private addresses that the benchmark and the admin connection
# test may reach. Outbound VL calls run through safe_fetch, which blocks
# private targets unless they are listed here; cloud-metadata addresses stay
# blocked regardless. Same syntax as IMPORT_PRIVATE_HOST_ALLOWLIST.
#VL_PRIVATE_HOST_ALLOWLIST=["vl.internal:8000"]

# Hostnames ("host" or "host:port") of private-network webhook targets on
# private addresses that outbound deliveries may reach. n8n im LAN? Host
# hier freigeben, z.B. 192.168.178.88. Deliveries run through safe_fetch,
# which blocks private targets unless they are listed here; cloud-metadata
# addresses stay blocked regardless. Same syntax as
# IMPORT_PRIVATE_HOST_ALLOWLIST.
#WEBHOOK_PRIVATE_HOST_ALLOWLIST=["192.168.178.88:5678"]
