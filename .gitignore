__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.env
venv/
backend/.venv/
test.db
backend/test.db
# Running pytest from inside backend/ resolves the relative UPLOADS_DIR/
# RESULTS_DIR against that directory, so test runs leave a nested copy.
backend/backend/
backend/storage/uploads/*
backend/storage/results/*
# Data directory of the pre-named-volume layout. Nothing creates it any more,
# but every installation that predates the switch still has one sitting in the
# checkout -- and it holds the Postgres cluster, so a stray `git add .` would
# publish accounts, documents and the credentials encrypted under SECRET_KEY.
nas-data/
frontend/node_modules/
frontend/.next/
.DS_Store
pictures/

# Temporary build / test artefacts (session logs, scratch files)
*.log
*-build.txt
*-result.txt
_out.txt
backend/paddledoc.db

# Local UI mockup (published as a Claude artifact, not part of releases)
docs/ui-mockup.html
